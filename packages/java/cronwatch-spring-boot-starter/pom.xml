<?xml version="1.0" encoding="UTF-8"?>
<!--
  dev.cronwatch:cronwatch-spring-boot-starter: auto-configuration for Spring
  Boot 3.5 and 4. Spring, ShedLock, and Quartz are optional: the app's own
  versions are the ones that run. -Dspring-boot.version=, -Dshedlock.version=,
  and -Dquartz.version= pick the ones the tests run against (the
  java-frameworks CI job runs the oldest and the newest).

  The dashboard's registration on Spring MVC and WebFlux is in
  dev.cronwatch.spring.web, apart from the client bean and the scheduler
  integrations.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.cronwatch</groupId>
    <artifactId>cronwatch-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>cronwatch-spring-boot-starter</artifactId>
  <packaging>jar</packaging>

  <name>CronWatch Spring Boot starter</name>
  <description>CronWatch for Spring Boot 3.5 and 4: the client from cronwatch.* properties, the dashboard on Spring MVC or WebFlux, every @Scheduled method watched with no code changes, ShedLock and Quartz handled.</description>

  <properties>
    <spring-boot.version>4.1.1</spring-boot.version>
    <shedlock.version>7.10.1</shedlock.version>
    <quartz.version>2.5.2</quartz.version>
    <jobrunr.version>8.8.2</jobrunr.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring's modules at one release; what the parent manages (JUnit, SLF4J, the servlet API) stays its own. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>dev.cronwatch</groupId>
      <artifactId>cronwatch</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The dashboard's filter on a servlet app; it needs the servlet API only when one runs. -->
    <dependency>
      <groupId>dev.cronwatch</groupId>
      <artifactId>cronwatch-servlet</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.cronwatch</groupId>
      <artifactId>cronwatch-quartz</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-core</artifactId>
      <version>${shedlock.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.quartz-scheduler</groupId>
      <artifactId>quartz</artifactId>
      <version>${quartz.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>dev.cronwatch</groupId>
      <artifactId>cronwatch-webtest</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
      <version>${shedlock.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- For the README's JobRunr example, which the starter's tests compile with the others. -->
    <dependency>
      <groupId>dev.cronwatch</groupId>
      <artifactId>cronwatch-jobrunr</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jobrunr</groupId>
      <artifactId>jobrunr</artifactId>
      <version>${jobrunr.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- For the readings report only: cron-utils' reading of a cron beside CronWatch's. -->
    <dependency>
      <groupId>com.cronutils</groupId>
      <artifactId>cron-utils</artifactId>
      <version>9.2.1</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs combine.children="append">
            <!-- Spring, ShedLock, and Quartz are automatic modules the API names. -->
            <arg>-Xlint:-requires-transitive-automatic</arg>
            <!-- The auto-configurations name Spring's types, which every app of the starter has. -->
            <arg>-Xlint:-exports</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
