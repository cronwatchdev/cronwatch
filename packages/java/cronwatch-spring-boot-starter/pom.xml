<?xml version="1.0" encoding="UTF-8"?>
<!--
  dev.cronwatch:cronwatch-spring-boot-starter: auto-configuration for Spring
  Boot 3.5 and 4. Spring is optional: the app's own version is the one that
  runs. -Dspring-boot.version= picks the one the tests run against.

  The dashboard's registration on Spring MVC and WebFlux is in
  dev.cronwatch.spring.web, apart from the client bean and the scheduler
  integrations.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.cronwatch</groupId>
    <artifactId>cronwatch-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>cronwatch-spring-boot-starter</artifactId>
  <packaging>jar</packaging>

  <name>CronWatch Spring Boot starter</name>
  <description>CronWatch for Spring Boot 3.5 and 4: the client from cronwatch.* properties, and the dashboard on Spring MVC or WebFlux.</description>

  <properties>
    <spring-boot.version>4.1.1</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring's modules at one release; what the parent manages (JUnit, SLF4J, the servlet API) stays its own. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>dev.cronwatch</groupId>
      <artifactId>cronwatch</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The dashboard's filter on a servlet app; it needs the servlet API only when one runs. -->
    <dependency>
      <groupId>dev.cronwatch</groupId>
      <artifactId>cronwatch-servlet</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>dev.cronwatch</groupId>
      <artifactId>cronwatch</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
