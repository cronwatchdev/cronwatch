<?xml version="1.0" encoding="UTF-8"?>
<!--
  dev.cronwatch:cronwatch, the core. It has no dependencies at all: nothing
  in compile or runtime scope, which the Enforcer rule below holds. What it
  compiles against beyond the JDK (JSpecify's annotations, SLF4J's MDC,
  Micrometer's context propagation) is provided, used only when the app has
  it; the database drivers are the tests' alone.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.cronwatch</groupId>
    <artifactId>cronwatch-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>cronwatch</artifactId>
  <packaging>jar</packaging>

  <name>CronWatch</name>
  <description>Monitoring for scheduled jobs on the JVM: missed, failed, stuck, slow and over-budget runs, alerted once and recovered once. The same library as @cronwatch/sdk.</description>

  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>context-propagation</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Cronwatch.VERSION is read from here, filtered with the version. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>dev/cronwatch/version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>dev/cronwatch/version.properties</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <!-- The core depends on nothing: no compile or runtime dependency, direct or not. -->
                <bannedDependencies>
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                  <message>dev.cronwatch:cronwatch has no compile or runtime dependencies (packages/java/DESIGN.md, Rules).</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
