<?xml version="1.0" encoding="UTF-8"?>
<!--
  The parent and aggregator of the Java port. The release's version lives
  here alone, in <revision>; every module's version is ${revision}, and the
  flatten plugin writes the resolved version into the POMs that are
  published (Maven's CI-friendly versions). scripts/release.mjs bumps it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.cronwatch</groupId>
  <artifactId>cronwatch-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>CronWatch (parent)</name>
  <description>Monitoring for scheduled jobs on the JVM: missed, failed, stuck, slow, over-budget and under-floor runs, alerted once and recovered once.</description>
  <url>https://cronwatch.dev</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Jon Phillips</name>
      <url>https://cronwatch.dev</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/phillips-jon/cronwatch.git</connection>
    <developerConnection>scm:git:git@github.com:phillips-jon/cronwatch.git</developerConnection>
    <url>https://github.com/phillips-jon/cronwatch/tree/main/packages/java</url>
    <tag>v${revision}</tag>
  </scm>

  <modules>
    <module>cronwatch</module>
    <module>webtest</module>
    <module>cronwatch-servlet</module>
    <module>cronwatch-quartz</module>
    <module>cronwatch-jobrunr</module>
    <module>cronwatch-spring-boot-starter</module>
    <module>webserver</module>
    <module>examples/crontab</module>
  </modules>

  <properties>
    <revision>0.12.2</revision>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- The repository's conformance fixtures, read by the tests; no jar carries them. -->
    <cronwatch.repo>${maven.multiModuleProjectDirectory}/../..</cronwatch.repo>

    <errorprone.version>2.50.0</errorprone.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <junit.version>6.1.3</junit.version>
    <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
    <postgresql.version>42.7.13</postgresql.version>
    <mysql-connector-j.version>26.7.0</mysql-connector-j.version>
    <mariadb-java-client.version>3.5.10</mariadb-java-client.version>
    <jspecify.version>1.0.1</jspecify.version>
    <slf4j.version>2.0.20</slf4j.version>
    <context-propagation.version>1.2.1</context-propagation.version>
    <!-- The web adapters: the servlet API they compile against (the floor), and the servers the tests run. -->
    <jakarta-servlet.version>6.0.0</jakarta-servlet.version>
    <jetty.version>12.1.13</jetty.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${jspecify.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>context-propagation</artifactId>
        <version>${context-propagation.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>${mysql-connector-j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mariadb.jdbc</groupId>
        <artifactId>mariadb-java-client</artifactId>
        <version>${mariadb-java-client.version}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.servlet</groupId>
        <artifactId>jakarta.servlet-api</artifactId>
        <version>${jakarta-servlet.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty.ee10</groupId>
        <artifactId>jetty-ee10-servlet</artifactId>
        <version>${jetty.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
          <configuration>
            <propertiesEncoding>UTF-8</propertiesEncoding>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <!--
            Every doclint check but "missing" (a @param or @return the prose
            already names), with its warnings as errors, as the compiler has
            them; CI builds the javadoc on the newest JDK.
          -->
          <configuration>
            <doclint>all,-missing</doclint>
            <failOnWarnings>true</failOnWarnings>
            <quiet>true</quiet>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.8</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.6.3</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>1.8.0</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>3.10.3</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.11.0</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <!-- One version of each dependency across the build. -->
                <dependencyConvergence/>
                <!-- Every class is Java 21 bytecode, whatever JDK builds it. -->
                <enforceBytecodeVersion>
                  <maxJdkVersion>21</maxJdkVersion>
                  <ignoredScopes>
                    <ignoredScope>test</ignoredScope>
                    <ignoredScope>provided</ignoredScope>
                  </ignoredScopes>
                </enforceBytecodeVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>extra-enforcer-rules</artifactId>
            <version>1.12.0</version>
          </dependency>
        </dependencies>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- The license in every jar, at META-INF/LICENSE, as the Rust port puts one in each crate. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>license</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
              <resources>
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}</directory>
                  <includes>
                    <include>LICENSE</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <showWarnings>true</showWarnings>
          <failOnWarning>true</failOnWarning>
          <compilerArgs>
            <!-- Not try: a Store (and AutoCloseable itself) may throw any exception from close(). -->
            <arg>-Xlint:all,-processing,-requires-automatic,-try</arg>
            <arg>-Werror</arg>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <!--
              Error Prone's warnings fail the build too (-Werror). The checks
              switched off are named here, each for the code it would flag:
              the croner port, the regular expression engine and the JSON
              reader follow their originals line for line.
            -->
            <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -Xep:MissingSummary:OFF -Xep:InlineMeSuggester:OFF -Xep:NarrowingCompoundAssignment:OFF -Xep:OperatorPrecedence:OFF -Xep:UnusedVariable:ERROR -Xep:JavaTimeDefaultTimeZone:OFF -Xep:StatementSwitchToExpressionSwitch:OFF</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The fixtures are made in UTC; a test checks both. -->
          <environmentVariables>
            <TZ>UTC</TZ>
          </environmentVariables>
          <!-- sqlite-jdbc loads its native library; JDK 24 and newer warn unless native access is on. -->
          <argLine>-Duser.timezone=UTC --enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <cronwatch.repo>${cronwatch.repo}</cronwatch.repo>
          </systemPropertyVariables>
          <!-- Tests run on the class path, as most apps do; ModuleTest reads the descriptor. -->
          <useModulePath>false</useModulePath>
          <includes>
            <include>**/*Test.java</include>
            <!-- The properties, one per door untrusted input comes through (Gen). -->
            <include>**/*Properties.java</include>
          </includes>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The release: sources and javadoc jars, a PGP signature on every file,
      and the bundle uploaded to the Central Publisher Portal. By hand the
      first time (./mvnw -P release deploy), checked in the Portal before it
      is published; java.yml sets cronwatch.autoPublish to true.
    -->
    <profile>
      <id>release</id>
      <properties>
        <cronwatch.autoPublish>false</cronwatch.autoPublish>
        <cronwatch.waitUntil>validated</cronwatch.waitUntil>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>${cronwatch.autoPublish}</autoPublish>
              <waitUntil>${cronwatch.waitUntil}</waitUntil>
              <!-- The flattened POMs stand alone, so the parent is not published. -->
              <excludeArtifacts>
                <artifact>cronwatch-parent</artifact>
                <artifact>cronwatch-example-crontab</artifact>
                <artifact>cronwatch-webserver</artifact>
                <artifact>cronwatch-webtest</artifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
