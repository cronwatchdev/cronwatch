<Project>
  <!-- Every dependency, pinned in one place. The Cronwatch package has none;
       these are build-time analyzers and the tests' own. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The integrations' schedulers, chosen with -p:HangfireVersion= and
         -p:QuartzVersion= (CI's dotnet-frameworks runs the oldest and newest
         each supports). NuGet resolves the lowest version that satisfies a
         package's range, so the package's own floor is the oldest. -->
    <HangfireVersion Condition="'$(HangfireVersion)' == ''">1.8.25</HangfireVersion>
    <QuartzVersion Condition="'$(QuartzVersion)' == ''">4.3.0</QuartzVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Hangfire">
    <PackageVersion Include="Hangfire.Core" Version="$(HangfireVersion)" />
    <PackageVersion Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
  </ItemGroup>
  <ItemGroup Label="Quartz">
    <PackageVersion Include="Quartz" Version="$(QuartzVersion)" />
  </ItemGroup>
</Project>
