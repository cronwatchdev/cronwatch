<Project>
  <!-- Every dependency, pinned in one place. The Cronwatch package has none;
       these are build-time analyzers and the tests' own. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The integrations' schedulers. Each package asks for the oldest release
         it supports (its floor, what NuGet resolves for an app that has no
         other), and the tests run on the release chosen with
         -p:HangfireVersion= and -p:QuartzVersion=, the newest by default
         (CI's dotnet-frameworks runs the floor and the newest). -->
    <HangfireFloor>1.8.0</HangfireFloor>
    <HangfireVersion Condition="'$(HangfireVersion)' == ''">1.8.25</HangfireVersion>
    <QuartzFloor>4.0.0</QuartzFloor>
    <QuartzVersion Condition="'$(QuartzVersion)' == ''">4.3.0</QuartzVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Hangfire">
    <PackageVersion Include="Hangfire.Core" Version="$(HangfireFloor)" />
    <PackageVersion Include="Hangfire.InMemory" Version="1.0.0" />
    <!-- The Cronos Hangfire 1.8 carries inside its own assembly (1.8.25's is
         0.11.1, compared line for line), for reading its crons as it does. -->
    <PackageVersion Include="Cronos" Version="0.11.1" />
    <!-- Hangfire.Core asks for Newtonsoft.Json 11.0.1, which has a known
         vulnerability (GHSA-5crp-9r3c-p9vr); Cronwatch.Hangfire asks for the
         fixed release, so an app that takes it gets that one. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup Label="Quartz">
    <PackageVersion Include="Quartz" Version="$(QuartzFloor)" />
    <!-- The readings report's third library (Cronos and Quartz are the others). -->
    <PackageVersion Include="NCrontab" Version="3.4.0" />
  </ItemGroup>
</Project>
