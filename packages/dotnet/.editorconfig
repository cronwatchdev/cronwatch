root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,slnx,json,xml}]
indent_size = 2

[*.cs]
# The layout dotnet format holds.
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:silent
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent
csharp_using_directive_placement = outside_namespace:silent
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Culture never changes a byte: every format and comparison names the
# invariant culture or ordinal comparison.
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1307.severity = error
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1311.severity = error

# Async: no captured context, tokens forwarded, a ValueTask awaited once,
# nothing blocking inside an async method.
dotnet_diagnostic.CA2007.severity = error
dotnet_diagnostic.CA2016.severity = error
dotnet_diagnostic.CA2012.severity = error
dotnet_diagnostic.CA1849.severity = error

# TLS and certificates are the platform's.
dotnet_diagnostic.CA5359.severity = error
dotnet_diagnostic.CA5398.severity = error

# Disposal.
dotnet_diagnostic.CA2000.severity = error

# The port follows its originals line for line: exceptions are caught
# broadly where the SDK catches any throw, and the SDK's names are kept.
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1003.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA2225.severity = none
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1508.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1028.severity = none
dotnet_diagnostic.CA1034.severity = none
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1814.severity = none
dotnet_diagnostic.CA1308.severity = none
dotnet_diagnostic.CA1845.severity = none
dotnet_diagnostic.CA1846.severity = none
dotnet_diagnostic.CA1865.severity = none
dotnet_diagnostic.CA1866.severity = none
dotnet_diagnostic.CA1867.severity = none
dotnet_diagnostic.CA1847.severity = none
dotnet_diagnostic.CA1510.severity = none
dotnet_diagnostic.CA1512.severity = none
dotnet_diagnostic.CA1513.severity = none
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1710.severity = none
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.CA1064.severity = none
dotnet_diagnostic.CA2201.severity = none
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.CA5351.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1851.severity = none
dotnet_diagnostic.CA1872.severity = none
dotnet_diagnostic.CA2263.severity = none
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0011.severity = silent

# The public API files: every method that reaches the store or the network
# takes its CancellationToken last and optional, beside overloads that take
# other optional parameters, as .NET's own async APIs do.
dotnet_diagnostic.RS0026.severity = none
dotnet_diagnostic.RS0027.severity = none
