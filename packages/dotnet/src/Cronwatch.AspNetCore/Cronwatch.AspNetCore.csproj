<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cronwatch.AspNetCore</RootNamespace>
    <AssemblyName>Cronwatch.AspNetCore</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Cronwatch.AspNetCore</PackageId>
    <Description>The CronWatch dashboard and a job's handler on ASP.NET Core: MapCronwatch, UseCronwatch and MapCronwatchHandler.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Cronwatch.Hosting/Cronwatch.Hosting.csproj" />
  </ItemGroup>
</Project>
