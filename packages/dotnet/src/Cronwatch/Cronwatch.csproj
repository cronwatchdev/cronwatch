<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cronwatch</RootNamespace>
    <AssemblyName>Cronwatch</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Cronwatch</PackageId>
    <Description>Know when your scheduled jobs fail, run long, or never run: missed, failed, stuck and over-budget alerts for cron jobs, kept in your own database.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The PDB is embedded in the assembly (Directory.Build.props), so there
         is no separate symbols package to push. -->
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Cronwatch.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The dashboard's style sheet, scripts and icons: the SDK's files, byte
         for byte, written and checked by golden.mjs and make-dashboard-icons.mjs,
         read once through GetManifestResourceStream under these names (spelled
         out, since RecursiveDir would name them with backslashes on Windows). -->
    <EmbeddedResource Include="Web/Assets/*" LogicalName="Cronwatch.Web.Assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Web/Assets/icons/*" LogicalName="Cronwatch.Web.Assets/icons/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
