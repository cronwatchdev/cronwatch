<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cronwatch.Hosting</RootNamespace>
    <AssemblyName>Cronwatch.Hosting</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Cronwatch.Hosting</PackageId>
    <Description>CronWatch in the Generic Host: the client as a singleton, options from configuration, the check as a hosted service, and errors through ILogger.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Cronwatch/Cronwatch.csproj" />
  </ItemGroup>
</Project>
