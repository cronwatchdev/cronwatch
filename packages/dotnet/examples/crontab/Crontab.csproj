<Project Sdk="Microsoft.NET.Sdk">
  <!-- Not packed: a job and its check run from two crontab lines, on SQLite. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Crontab</AssemblyName>
    <RootNamespace>Crontab</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- An app, not a library: no context to keep off the await. -->
    <NoWarn>$(NoWarn);CS1591;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Cronwatch/Cronwatch.csproj" />
  </ItemGroup>
</Project>
