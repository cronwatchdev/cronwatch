{
  "name": "@cronwatch/sdk",
  "version": "0.3.0",
  "description": "Cron and scheduled-job monitoring that lives inside your app. Wrap a job, mount a route, get told when it is missed, failed, slow or over budget. No server to run.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phillips-jon/cronwatch.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://cronwatch.dev",
  "keywords": [
    "cron",
    "monitoring",
    "scheduled jobs",
    "heartbeat",
    "vercel cron",
    "nextjs",
    "agents",
    "mcp"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "sqlite": [
        "./dist/sqlite.d.cts"
      ],
      "postgres": [
        "./dist/postgres.d.cts"
      ],
      "slack": [
        "./dist/slack.d.cts"
      ],
      "discord": [
        "./dist/discord.d.cts"
      ],
      "webhook": [
        "./dist/webhook.d.cts"
      ],
      "anthropic": [
        "./dist/anthropic.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/sqlite.d.ts",
        "default": "./dist/sqlite.js"
      },
      "require": {
        "types": "./dist/sqlite.d.cts",
        "default": "./dist/sqlite.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./slack": {
      "import": {
        "types": "./dist/slack.d.ts",
        "default": "./dist/slack.js"
      },
      "require": {
        "types": "./dist/slack.d.cts",
        "default": "./dist/slack.cjs"
      }
    },
    "./discord": {
      "import": {
        "types": "./dist/discord.d.ts",
        "default": "./dist/discord.js"
      },
      "require": {
        "types": "./dist/discord.d.cts",
        "default": "./dist/discord.cjs"
      }
    },
    "./webhook": {
      "import": {
        "types": "./dist/webhook.d.ts",
        "default": "./dist/webhook.js"
      },
      "require": {
        "types": "./dist/webhook.d.cts",
        "default": "./dist/webhook.cjs"
      }
    },
    "./anthropic": {
      "import": {
        "types": "./dist/anthropic.d.ts",
        "default": "./dist/anthropic.js"
      },
      "require": {
        "types": "./dist/anthropic.d.cts",
        "default": "./dist/anthropic.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "TZ=UTC node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "croner": "^10.0.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.115.0 <0.129.0",
    "@types/better-sqlite3": ">=7.6",
    "@types/pg": ">=8.11",
    "better-sqlite3": ">=9",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@types/better-sqlite3": {
      "optional": true
    },
    "@types/pg": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.15.0",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
