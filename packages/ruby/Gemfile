# frozen_string_literal: true

source "https://rubygems.org"

gemspec

gem "minitest", ">= 5.16"
gem "rake", ">= 13"

# Cronwatch::Web (require "cronwatch/web") is a Rack app; rack stays optional for apps.
gem "rack", ">= 2.2"

# Triage (require "cronwatch/triage/anthropic") is tested against the real client when it is here.
gem "anthropic", ">= 1.73", require: false

# The ActiveRecord store and the Rails integration are tested against one
# Rails at a time: 8.1 (the latest) by default, or the one CRONWATCH_RAILS
# names ("8.0", "7.2"). test/rails/gemfiles has a Gemfile per supported
# series with its own lockfile, so switching does not rewrite this one:
#
#   BUNDLE_GEMFILE=test/rails/gemfiles/rails_7_2.gemfile bundle install
#   BUNDLE_GEMFILE=test/rails/gemfiles/rails_7_2.gemfile bundle exec rake test
rails = ENV.fetch("CRONWATCH_RAILS", "8.1")
group :test do
  gem "activejob", "~> #{rails}.0"
  gem "activerecord", "~> #{rails}.0"
  gem "pg", ">= 1.5"
  gem "railties", "~> #{rails}.0"
  # Rails 8 takes sqlite3 2.x; 7.2 still takes 1.4 and up.
  gem "sqlite3", Gem::Version.new(rails) >= Gem::Version.new("8.0") ? ">= 2.1" : ">= 1.4"

  # The MCP server's tests start test/web/server.rb with rackup, which needs a server.
  gem "webrick", ">= 1.8"

  # Cronwatch::Sidekiq (require "cronwatch/sidekiq") runs under Sidekiq's own
  # testing harness, and schedules are read beside sidekiq-cron's own parse.
  # Sidekiq stays optional for apps. CRONWATCH_SIDEKIQ picks a series ("7"),
  # as CRONWATCH_RAILS does for Rails.
  gem "sidekiq", ENV["CRONWATCH_SIDEKIQ"] ? "~> #{ENV["CRONWATCH_SIDEKIQ"]}.0" : ">= 7.0", require: false
  gem "sidekiq-cron", ">= 1.12", require: false
end
