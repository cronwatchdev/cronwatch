<?php

/**
 * @file
 * Install and uninstall: the library's three tables.
 */

declare(strict_types=1);

use Drupal\cronwatch\Storage;

/**
 * Implements hook_install().
 *
 * The tables are made by the library's store, with the CREATE text every
 * port uses, through its own connection to the site's database; IF NOT
 * EXISTS, so tables another port already made are kept.
 */
function cronwatch_install(): void {
  Storage::store()->init();
}

/**
 * Implements hook_uninstall().
 */
function cronwatch_uninstall(): void {
  Storage::drop();
}

/**
 * Adds the settings for Discord, the email providers, Twilio, and the error trackers.
 */
function cronwatch_update_10001(): void {
  $config = \Drupal::configFactory()->getEditable('cronwatch.settings');
  foreach (\Cronwatch\Bridge\ChannelSettings::defaults() as $key => $default) {
    if ($config->get($key) === NULL) {
      $config->set($key, $default);
    }
  }
  $config->save(TRUE);
}
