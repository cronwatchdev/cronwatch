{
    "name": "drupal/cronwatch",
    "description": "Watches Drupal's cron: every hook_cron as a job, the queue workers you choose, alerts when a run is missed, fails, gets stuck or runs slow.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "keywords": ["Drupal", "cron", "monitoring", "queue", "alerts"],
    "homepage": "https://cronwatch.dev",
    "support": {
        "docs": "https://cronwatch.dev/docs/",
        "issues": "https://github.com/phillips-jon/cronwatch/issues",
        "source": "https://github.com/phillips-jon/cronwatch/tree/main/packages/php/drupal"
    },
    "require": {
        "php": ">=8.2",
        "cronwatch/cronwatch": "^0.9.0"
    }
}
