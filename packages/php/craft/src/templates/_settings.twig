{% import '_includes/forms.twig' as forms %}

<p>{{ 'Nothing leaves the site until a channel is set; with none, alerts go to Craft’s log. Each field takes an environment variable ($SLACK_WEBHOOK_URL), so a credential need not be in project config.'|t('cronwatch') }}</p>

{{ forms.autosuggestField({
  label: 'Email alerts to'|t('cronwatch'),
  instructions: 'One or more addresses, separated by commas. Sent through Craft’s mailer.'|t('cronwatch'),
  name: 'emailTo',
  value: settings.emailTo,
  suggestEnvVars: true,
  errors: settings.getErrors('emailTo'),
  disabled: 'emailTo' in overrides,
}) }}

{{ forms.autosuggestField({
  label: 'Slack incoming webhook URL'|t('cronwatch'),
  name: 'slackWebhookUrl',
  value: settings.slackWebhookUrl,
  suggestEnvVars: true,
  errors: settings.getErrors('slackWebhookUrl'),
  disabled: 'slackWebhookUrl' in overrides,
}) }}

{{ forms.autosuggestField({
  label: 'Webhook URL'|t('cronwatch'),
  instructions: 'Each alert is POSTed here as JSON.'|t('cronwatch'),
  name: 'webhookUrl',
  value: settings.webhookUrl,
  suggestEnvVars: true,
  errors: settings.getErrors('webhookUrl'),
  disabled: 'webhookUrl' in overrides,
}) }}

{{ forms.autosuggestField({
  label: 'Webhook signing secret'|t('cronwatch'),
  instructions: 'When set, each request is signed with HMAC-SHA256 in the X-CronWatch-Signature header.'|t('cronwatch'),
  name: 'webhookSecret',
  value: settings.webhookSecret,
  suggestEnvVars: true,
  errors: settings.getErrors('webhookSecret'),
  disabled: 'webhookSecret' in overrides,
}) }}

<h2>{{ 'More channels'|t('cronwatch') }}</h2>
<p>{{ 'Each channel sends once all of its required fields are set. Put keys and tokens in environment variables ($RESEND_API_KEY) to keep them out of project config.'|t('cronwatch') }}</p>

{% for section in sections %}
  <h3>{{ section.title|t('cronwatch') }}</h3>
  {% if section.intro %}<p>{{ section.intro|t('cronwatch') }}</p>{% endif %}
  {% for provider in section.providers %}
    <details class="cronwatch-channel"{{ provider.open ? ' open' }}>
      <summary><strong>{{ provider.label }}</strong></summary>
      {% for field in provider.fields %}
        {% set label = field.label|t('cronwatch') ~ (field.required or field.kind == 'choice' ? '' : ' ' ~ '(optional)'|t('cronwatch')) %}
        {% if field.kind == 'choice' %}
          {% set options = [] %}
          {% for value, text in field.options %}
            {% set options = options|merge([{label: text|t('cronwatch'), value: value}]) %}
          {% endfor %}
          {{ forms.selectField({
            label: label,
            name: field.name,
            value: attribute(settings, field.name),
            options: options,
            errors: settings.getErrors(field.name),
            disabled: field.name in overrides,
          }) }}
        {% else %}
          {{ forms.autosuggestField({
            label: label,
            instructions: field.help is defined ? field.help|t('cronwatch') : null,
            name: field.name,
            value: attribute(settings, field.name),
            suggestEnvVars: true,
            errors: settings.getErrors(field.name),
            disabled: field.name in overrides,
          }) }}
        {% endif %}
      {% endfor %}
    </details>
  {% endfor %}
{% endfor %}

<hr>

{{ forms.textField({
  label: 'Grace'|t('cronwatch'),
  instructions: 'How late a run may be before it is reported missed, such as 10m or 1h.'|t('cronwatch'),
  name: 'grace',
  value: settings.grace,
  errors: settings.getErrors('grace'),
  required: true,
  disabled: 'grace' in overrides,
}) }}

<p>{{ 'The console commands and queue jobs to watch, with their schedules, are set in {file} (see the plugin’s README). Run {command} from the server’s crontab every five minutes.'|t('cronwatch', {
  file: tag('code', {text: 'config/cronwatch.php'}),
  command: tag('code', {text: 'php craft cronwatch/check'}),
})|raw }}</p>

<hr>

<div class="field">
  <button type="button" class="btn formsubmit" data-action="cronwatch/settings/test-alert">{{ 'Send a test alert'|t('cronwatch') }}</button>
  <p class="light">{{ 'Sends one alert to every channel the saved settings name and shows what each answered. Save your changes first.'|t('cronwatch') }}</p>
</div>
