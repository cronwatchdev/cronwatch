{% import '_includes/forms.twig' as forms %}

{#
  A field config/cronwatch.php sets is shown disabled and empty, so a value the file reads from the
  environment never reaches the page. A secret written in plain is never shown again: its field left
  blank keeps it, and its "Remove it" box clears it. An environment variable's name is shown as written.
#}
{% macro instructions(name, help, overrides, saved) %}
  {%- if name in overrides -%}
    {{ 'Set in config/cronwatch.php.'|t('cronwatch') }}
  {%- elseif name in saved -%}
    {{ 'One is saved. Leave blank to keep it.'|t('cronwatch') }}{{ help ? ' ' ~ help }}
  {%- else -%}
    {{ help }}
  {%- endif -%}
{% endmacro %}

{% macro removeBox(name, saved) %}
  {% import '_includes/forms.twig' as forms %}
  {% if name in saved %}
    {{ forms.checkboxField({
      label: 'Remove it'|t('cronwatch'),
      name: name ~ 'Clear',
      value: '1',
    }) }}
  {% endif %}
{% endmacro %}

{% if apiTokenProblem %}
  <p class="error with-icon">{{ 'The JSON API is off: its token (apiToken in config/cronwatch.php, or CRONWATCH_TOKEN) is shorter than {min} characters. Make a longer one, such as the output of {command}.'|t('cronwatch', {
    min: constant('Cronwatch\\Craft\\Recorder::TOKEN_MIN'),
    command: tag('code', {text: 'openssl rand -hex 24'}),
  })|raw }}</p>
{% endif %}

<p>{{ 'Nothing leaves the site until a channel is set; with none, alerts go to Craft’s log. Each field takes an environment variable ($SLACK_WEBHOOK_URL), so a credential need not be in project config.'|t('cronwatch') }}</p>

{{ forms.autosuggestField({
  label: 'Email alerts to'|t('cronwatch'),
  instructions: _self.instructions('emailTo', 'One or more addresses, separated by commas. Sent through Craft’s mailer.'|t('cronwatch'), overrides, saved),
  name: 'emailTo',
  value: values.emailTo,
  suggestEnvVars: true,
  errors: settings.getErrors('emailTo'),
  disabled: 'emailTo' in overrides,
}) }}

{{ forms.autosuggestField({
  label: 'Slack incoming webhook URL'|t('cronwatch'),
  instructions: _self.instructions('slackWebhookUrl', null, overrides, saved),
  name: 'slackWebhookUrl',
  value: values.slackWebhookUrl,
  suggestEnvVars: true,
  errors: settings.getErrors('slackWebhookUrl'),
  disabled: 'slackWebhookUrl' in overrides,
}) }}

{{ forms.autosuggestField({
  label: 'Webhook URL'|t('cronwatch'),
  instructions: _self.instructions('webhookUrl', 'Each alert is POSTed here as JSON.'|t('cronwatch'), overrides, saved),
  name: 'webhookUrl',
  value: values.webhookUrl,
  suggestEnvVars: true,
  errors: settings.getErrors('webhookUrl'),
  disabled: 'webhookUrl' in overrides,
}) }}

{{ forms.autosuggestField({
  label: 'Webhook signing secret'|t('cronwatch'),
  instructions: _self.instructions('webhookSecret', 'When set, each request is signed with HMAC-SHA256 in the X-CronWatch-Signature header.'|t('cronwatch'), overrides, saved),
  name: 'webhookSecret',
  value: values.webhookSecret,
  suggestEnvVars: true,
  errors: settings.getErrors('webhookSecret'),
  disabled: 'webhookSecret' in overrides,
}) }}
{{ _self.removeBox('webhookSecret', saved) }}

<h2>{{ 'More channels'|t('cronwatch') }}</h2>
<p>{{ 'Each channel sends once all of its required fields are set. Put keys and tokens in environment variables ($RESEND_API_KEY) to keep them out of project config.'|t('cronwatch') }}</p>

{% for section in sections %}
  <h3>{{ section.title|t('cronwatch') }}</h3>
  {% if section.intro %}<p>{{ section.intro|t('cronwatch') }}</p>{% endif %}
  {% for provider in section.providers %}
    <details class="cronwatch-channel"{{ provider.open ? ' open' }}>
      <summary><strong>{{ provider.label }}</strong></summary>
      {% for field in provider.fields %}
        {% set label = field.label|t('cronwatch') ~ (field.required or field.kind == 'choice' ? '' : ' ' ~ '(optional)'|t('cronwatch')) %}
        {% if field.kind == 'choice' %}
          {% set options = [] %}
          {% for value, text in field.options %}
            {% set options = options|merge([{label: text|t('cronwatch'), value: value}]) %}
          {% endfor %}
          {{ forms.selectField({
            label: label,
            instructions: field.name in overrides ? 'Set in config/cronwatch.php.'|t('cronwatch') : null,
            name: field.name,
            value: values[field.name] ?? '',
            options: options,
            errors: settings.getErrors(field.name),
            disabled: field.name in overrides,
          }) }}
        {% else %}
          {{ forms.autosuggestField({
            label: label,
            instructions: _self.instructions(field.name, field.help is defined ? field.help|t('cronwatch') : null, overrides, saved),
            name: field.name,
            value: values[field.name] ?? '',
            suggestEnvVars: true,
            errors: settings.getErrors(field.name),
            disabled: field.name in overrides,
          }) }}
          {{ _self.removeBox(field.name, saved) }}
        {% endif %}
      {% endfor %}
    </details>
  {% endfor %}
{% endfor %}

<hr>

{{ forms.textField({
  label: 'Grace'|t('cronwatch'),
  instructions: 'How late a run may be before it is reported missed, such as 10m or 1h.'|t('cronwatch'),
  name: 'grace',
  value: values.grace,
  errors: settings.getErrors('grace'),
  required: true,
  disabled: 'grace' in overrides,
}) }}

<p>{{ 'The console commands and queue jobs to watch, with their schedules, are set in {file} (see the plugin’s README). Run {command} from the server’s crontab every five minutes.'|t('cronwatch', {
  file: tag('code', {text: 'config/cronwatch.php'}),
  command: tag('code', {text: 'php craft cronwatch/check'}),
})|raw }}</p>

<hr>

<div class="field">
  <button type="button" class="btn formsubmit" data-action="cronwatch/settings/test-alert">{{ 'Send a test alert'|t('cronwatch') }}</button>
  <p class="light">{{ 'Sends one alert to every channel the saved settings name and shows what each answered. Save your changes first.'|t('cronwatch') }}</p>
</div>
