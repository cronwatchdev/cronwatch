#!/bin/bash
# Point cronwatch.dev back at an earlier release. It only moves the symlink
# nginx serves through, so it takes effect at once:
#
#   ssh joncpu /var/www/cronwatch.dev/deploy/rollback          # the release before the live one
#   ssh joncpu /var/www/cronwatch.dev/deploy/rollback <name>   # one listed in /var/www/cronwatch.dev-releases
#
# Only releases that passed their build check (marked .release-ok) qualify.
# Like release-deploy, it confirms nginx serves the release it switched to,
# and switches back if not.
# The next push to main deploys as usual once CI passes, so push a fix (or a revert) next.

set -euo pipefail

SITE=cronwatch.dev
LIVE=/var/www/$SITE
RELEASES=/var/www/$SITE-releases
WEB_ROOT=site/dist

# Never at the same time as a deploy, and the target is chosen under the
# lock, so a deploy finishing meanwhile cannot change what "the release
# before the live one" means.
exec 9>"$RELEASES/.deploy.lock"   # not /tmp, where any local user could pre-create or symlink it
flock -n 9 || { echo "A deploy is running; try again when it finishes." >&2; exit 1; }

current=$(readlink -f "$LIVE")
if [ -n "${1:-}" ]; then
    target="$RELEASES/$(basename "$1")"
else
    # Release names start with their build time, so they sort oldest first.
    target=$(for d in $(ls -1d "$RELEASES"/*/ 2>/dev/null | sed 's#/$##' | sort); do
        if [ -f "$d/.release-ok" ]; then echo "$d"; fi
    done | awk -v cur="$current" '$0 == cur { print prev } { prev = $0 }')
fi

if [ -z "$target" ] || [ ! -f "$target/.release-ok" ] || [ "$(readlink -f "$target")" = "$current" ]; then
    echo "No earlier release that passed its checks to roll back to (live: $(basename "$current"))." >&2
    exit 1
fi

switch_to() {
    ln -sfn "$1" "$LIVE.next"
    mv -T "$LIVE.next" "$LIVE"
}

switch_to "$target"

# The front page must answer 200 with exactly the index.html of the release
# switched to (asset names are content hashes, so another release differs).
page=$(mktemp)
code=$(curl -s -o "$page" -w '%{http_code}' --max-time 10 -H 'Cache-Control: no-cache' "https://$SITE/" || true)
served=false
if [ "$code" = "200" ] && cmp -s "$page" "$target/$WEB_ROOT/index.html"; then
    served=true
fi
rm -f "$page"
if ! $served; then
    switch_to "$current"
    echo "https://$SITE/ answered $code after switching to $(basename "$target"), not with its page; went back to $(basename "$current")." >&2
    exit 1
fi

echo "Rolled back to $(basename "$target"): $(git -C "$target" log -1 --format='%h %s')"
