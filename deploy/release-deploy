#!/bin/bash
# Deploy cronwatch.dev (the static site in site/dist). Runs on the server as
# the joncphillips user:
#
#   ssh joncpu /var/www/cronwatch.dev/deploy/release-deploy [--force | --prepare] [<commit>]
#
# <commit> is a full 40-character commit id on main; without one it deploys
# the tip of main. The GitHub Action runs it after CI passes on a push to
# main, through a key whose authorized_keys entry forces this script, so the
# commit arrives in SSH_ORIGINAL_COMMAND as "deploy <commit>": the commit CI
# passed, deployed exactly, never whatever main has moved on to since. A
# commit that is already live, or older than the live one (CI runs finishing
# out of order), is skipped. Each deploy builds a new
# release beside the live one, so a build never touches what is serving:
#
#   /var/www/cronwatch.dev-repo.git          bare clone that fetches from GitHub
#   /var/www/cronwatch.dev-releases/<name>/  one git worktree per release, built where it sits
#   /var/www/cronwatch.dev                   symlink to the live release; nginx serves its site/dist
#
# A new release gets npm ci and `npm run build:site`. The output must contain
# an index.html that mentions CronWatch and carries the day's strip (the build
# fails without the demo captures, and this catches it if it ever did not),
# plus the docs. Only then is the release marked
# .release-ok and the symlink moved (one rename). nginx follows the symlink,
# so there is no service to restart. The newest releases that went live are
# kept for ./rollback.
#
#   --force    build a release even when the live one is current
#   --prepare  build and check a release but don't switch to it (the first
#              release, before the live path became a symlink)

set -Eeuo pipefail
# With SIGPIPE ignored, a dropped SSH connection makes the next write fail
# (and trips the ERR trap) instead of killing this script mid-step.
trap '' PIPE

SITE=cronwatch.dev
LIVE=/var/www/$SITE
REPO=/var/www/$SITE-repo.git
RELEASES=/var/www/$SITE-releases
NODE_PREFIX=${CRONWATCH_NODE:-/opt/node-cronwatch}
WEB_ROOT=site/dist
KEEP=3

MODE=""
WANT=""
if [ $# -eq 0 ] && [ -n "${SSH_ORIGINAL_COMMAND+set}" ]; then
    # The deploy key's forced command: what the client asked for is only
    # read, never run. "deploy" alone (an older workflow) deploys main.
    if [[ "$SSH_ORIGINAL_COMMAND" =~ ^deploy(\ ([0-9a-f]{40}))?$ ]]; then
        WANT="${BASH_REMATCH[2]}"
    else
        echo "Refusing the command sent over SSH; expected 'deploy' or 'deploy <40-character commit id>'." >&2
        exit 1
    fi
else
    for arg in "$@"; do
        case "$arg" in
            --force | --prepare)
                [ -z "$MODE" ] || { echo "Give --force or --prepare, not both." >&2; exit 1; }
                MODE="$arg"
                ;;
            *)
                if [[ "$arg" =~ ^[0-9a-f]{40}$ ]] && [ -z "$WANT" ]; then
                    WANT="$arg"
                else
                    echo "Usage: release-deploy [--force | --prepare] [<40-character commit id>]" >&2
                    exit 1
                fi
                ;;
        esac
    done
fi
PREPARE=false
[ "$MODE" = "--prepare" ] && PREPARE=true

if [ "$(id -u)" -eq 0 ]; then
    echo "Run this as joncphillips, not root." >&2
    exit 1
fi
for path in "$REPO" "$RELEASES" "$NODE_PREFIX/bin/node"; do
    if [ ! -e "$path" ]; then
        echo "Missing $path, so the release layout isn't set up (deploy/README.md)." >&2
        exit 1
    fi
done
if [ -e "$LIVE" ] && [ ! -L "$LIVE" ] && ! $PREPARE; then
    echo "$LIVE is not a symlink to a release yet; build one with --prepare and switch to it by hand." >&2
    exit 1
fi
export PATH="$NODE_PREFIX/bin:$PATH"

# One deploy at a time; rollback takes the same lock.
exec 9>"$RELEASES/.deploy.lock"   # not /tmp, where any local user could pre-create or symlink it
flock -n 9 || { echo "Another deploy is already running." >&2; exit 1; }

echo "Fetching..."
git -C "$REPO" fetch --quiet origin
MAIN=$(git -C "$REPO" rev-parse refs/remotes/origin/main)
if [ -n "$WANT" ]; then
    # Only a commit on main: never a branch, a pull request or anything else
    # that merely exists in the clone.
    if ! git -C "$REPO" cat-file -e "$WANT^{commit}" 2>/dev/null; then
        echo "Commit $WANT is not in the clone after fetching." >&2
        exit 1
    fi
    if ! git -C "$REPO" merge-base --is-ancestor "$WANT" "$MAIN"; then
        echo "Commit $WANT is not on main." >&2
        exit 1
    fi
    NEW="$WANT"
else
    NEW="$MAIN"
fi
CURRENT=""
CURRENT_DIR=""
if [ -L "$LIVE" ]; then
    CURRENT_DIR=$(readlink -f "$LIVE")
    CURRENT=$(git -C "$CURRENT_DIR" rev-parse HEAD 2>/dev/null || true)
fi
if [ "$NEW" = "$CURRENT" ] && [ "$MODE" != "--force" ] && ! $PREPARE; then
    echo "Already live: $(git -C "$REPO" log -1 --format='%h %s' "$NEW")"
    exit 0
fi
# CI runs can finish out of order: never replace the live release with an
# older commit unless asked to (--force, or ./rollback).
if [ -n "$WANT" ] && [ -n "$CURRENT" ] && [ "$MODE" != "--force" ] && ! $PREPARE \
    && git -C "$REPO" merge-base --is-ancestor "$NEW" "$CURRENT" 2>/dev/null; then
    echo "Not deploying $(git -C "$REPO" rev-parse --short "$NEW"): it is older than the live $(git -C "$REPO" rev-parse --short "$CURRENT")."
    exit 0
fi

# Release names start with their build time, and rollback and pruning go by
# that order, so no two releases may share a second.
STAMP=$(date +%Y%m%d-%H%M%S)
while ls -d "$RELEASES/$STAMP"-* >/dev/null 2>&1; do
    sleep 1
    STAMP=$(date +%Y%m%d-%H%M%S)
done
DIR="$RELEASES/$STAMP-$(git -C "$REPO" rev-parse --short "$NEW")"
CREATED=false

abandon() {
    # set -E hands this trap to $(...) subshells too. A failure in one ends
    # only that subshell; the main shell then sees its command fail.
    [ "${BASH_SUBSHELL:-0}" -gt 0 ] && exit 1
    trap - ERR INT TERM HUP
    set +e
    echo "Deploy failed. The live site is unchanged; removing the unfinished release." >&2
    cd /
    # Only a release this run created, and never the live one.
    if $CREATED && [ "$(readlink -f "$LIVE")" != "$DIR" ]; then
        git -C "$REPO" worktree remove --force "$DIR" 2>/dev/null || rm -rf "$DIR"
    fi
    git -C "$REPO" worktree prune
    exit 1
}
trap abandon ERR INT TERM HUP

echo "Building $(basename "$DIR")..."
git -C "$REPO" worktree add --quiet --detach "$DIR" "$NEW"
CREATED=true
cd "$DIR"

echo "Installing npm packages (Node $(node -v))..."
# 9>&-: nothing started here may hold the deploy lock. The site builds from
# committed captures and needs only marked, so only its workspace is
# installed; the packages (and native drivers like better-sqlite3) are not.
npm ci --workspace site --no-audit --no-fund --ignore-scripts 9>&-

echo "Building the site..."
npm run build:site 9>&-
[ -f "$WEB_ROOT/index.html" ] || { echo "The build left no $WEB_ROOT/index.html." >&2; false; }
grep -q "CronWatch" "$WEB_ROOT/index.html" || { echo "$WEB_ROOT/index.html does not look like the site." >&2; false; }
grep -q '<svg class="tl wide"' "$WEB_ROOT/index.html" || { echo "$WEB_ROOT/index.html has no timeline of runs; are the demo captures missing?" >&2; false; }
[ -f "$WEB_ROOT/docs/index.html" ] || { echo "The build left no docs." >&2; false; }
# The build output is all nginx serves; node_modules is not needed after this.
rm -rf node_modules
touch .release-ok

if $PREPARE; then
    trap - ERR INT TERM HUP
    echo "Prepared $DIR (not live)."
    exit 0
fi

# Go live: the symlink moves in one rename, so each request sees either the
# old release or the new one, never a mix.
trap - ERR INT TERM HUP
ln -sfn "$DIR" "$LIVE.next"
mv -T "$LIVE.next" "$LIVE"
echo "Live: $(git log -1 --format='%h %s')"

# Confirm nginx serves the new release, not just something: the front page
# must answer 200 with exactly the index.html this build wrote (its asset
# names are hashes of their content, so an older release differs). nginx
# follows the symlink, so nothing needs restarting.
page=$(mktemp)
code=$(curl -s -o "$page" -w '%{http_code}' --max-time 10 -H 'Cache-Control: no-cache' "https://$SITE/" || true)
served=false
if [ "$code" = "200" ] && cmp -s "$page" "$WEB_ROOT/index.html"; then
    served=true
fi
rm -f "$page"
if ! $served; then
    echo "https://$SITE/ answered $code after the switch, not with the page this release built." >&2
    rm -f "$DIR/.release-ok"
    if [ -n "$CURRENT_DIR" ]; then
        ln -sfn "$CURRENT_DIR" "$LIVE.next"
        mv -T "$LIVE.next" "$LIVE"
        echo "Went back to $(basename "$CURRENT_DIR")." >&2
    else
        echo "!!! There is no previous release to go back to, so $(basename "$DIR") is STILL LIVE" >&2
        echo "!!! but was not seen being served. Check nginx and https://$SITE/ by hand." >&2
    fi
    exit 1
fi

# Keep the newest releases that went live, for rollback; anything else goes.
LIVE_DIR=$(readlink -f "$LIVE")
kept=0
for old in $(ls -1d "$RELEASES"/*/ 2>/dev/null | sed 's#/$##' | sort -r); do
    if [ "$old" = "$LIVE_DIR" ]; then
        kept=$((kept + 1))
    elif [ -f "$old/.release-ok" ] && [ "$kept" -lt "$KEEP" ]; then
        kept=$((kept + 1))
    else
        git -C "$REPO" worktree remove --force "$old" 2>/dev/null || rm -rf "$old"
    fi
done
git -C "$REPO" worktree prune || true

# The contact form service keeps running the code it started with. This runs
# without sudo, so it only says when a restart is needed.
if [ -n "$CURRENT" ] && ! git -C "$REPO" diff --quiet "$CURRENT" "$NEW" -- deploy/contact 2>/dev/null; then
    echo "deploy/contact changed: run 'sudo systemctl restart cronwatch-contact' to pick it up."
fi

echo "Deployed $(git log -1 --format=%h)."
